# Copy to .env and fill in your own credentials. Never commit .env.
AGENTCLI_PROVIDER=deepseek
AGENTCLI_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# Optional generic provider key and OpenAI-compatible service URL.
AGENTCLI_API_KEY=
# AGENTCLI_BASE_URL=http://127.0.0.1:11434/v1

# Required only when running the local Runtime API.
AGENTCLI_RUNTIME_API_KEY=
